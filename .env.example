# Local database. Generate POSTGRES_PASSWORD before running Docker Compose.
POSTGRES_PASSWORD=
DATABASE_URL=

# Bind locally by default for development.
DEMONCLAW_HTTP_BIND=127.0.0.1:3000

# Enable token authentication for POST /ingest.
DEMONCLAW_INGEST_AUTH_ENABLED=1
DEMONCLAW_TOKEN=

# Optional provider configuration.
SIGNALGATE_BASE_URL=https://api.openai.com/v1
SIGNALGATE_API_KEY=
SIGNALGATE_MODEL=gpt-4o
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Conservative operational defaults.
DEMONCLAW_REQUIRE_ENGAGEMENT=1
DEMONCLAW_ENGAGEMENT_ID=
DEMONCLAW_ALLOW_PRIVATE_ONLY=1
DEMONCLAW_MAX_TOOL_LEVEL=passive
GHOSTMCP_AUTO_APPROVE=0
